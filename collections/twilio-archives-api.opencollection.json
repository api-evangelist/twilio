{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Archives API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "Archives",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "DeleteArchivedCall",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.twilio.com/v1/Archives/:Date/Calls/:Sid",
            "params": [
              {
                "name": "Date",
                "value": "",
                "type": "path",
                "description": "The date of the Call in UTC."
              },
              {
                "name": "Sid",
                "value": "",
                "type": "path",
                "description": "The Twilio-provided Call SID that uniquely identifies the Call resource to delete"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete an archived call record from Bulk Export. Note: this does not also delete the record from the Voice API."
        }
      ]
    }
  ],
  "bundled": true
}