          "id": "1db8d17f-9bb9-4f4d-8602-acc474b7e695",
          "name": "Create Command",
          "request": {
            "name": "Create Command",
            "description": {
              "content": "Send a Command to a Sim.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "Commands"
