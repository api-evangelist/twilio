                "description": "The SID of the Verify service"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "Identity",
                  "value": ""
                },
                {
                  "name": "FactorType",
                  "value": ""
                },
                {
                  "name": "FactorFriendlyName",
                  "value": ""
                },
                {
                  "name": "Ttl",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Generate an access token for use with Verify Push or TOTP SDKs."
        }
      ]
    }
  ],
  "bundled": true
