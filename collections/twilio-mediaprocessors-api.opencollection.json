                "name": "Sid",
                "value": "",
                "type": "path",
                "description": "The SID of the MediaProcessor resource to update."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Updates a MediaProcessor resource identified by a SID."
        }
      ]
    }
  ],
