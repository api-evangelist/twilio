{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Media API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "Media",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twilio List Media for a Message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/Accounts/:AccountSid/Messages/:MessageSid/Media.json",
            "params": [
              {
                "name": "AccountSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Twilio account"
              },
              {
                "name": "MessageSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the message"
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a list of media associated with an MMS message."
        },
        {
          "info": {
            "name": "Twilio Fetch a Media Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/Accounts/:AccountSid/Messages/:MessageSid/Media/:MediaSid.json",
            "params": [
              {
                "name": "AccountSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Twilio account"
              },
              {
                "name": "MessageSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the message"
              },
              {
                "name": "MediaSid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a specific media resource associated with a message."
        },
        {
          "info": {
            "name": "Twilio Delete a Media Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.twilio.com/Accounts/:AccountSid/Messages/:MessageSid/Media/:MediaSid.json",
            "params": [
              {
                "name": "AccountSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the Twilio account"
              },
              {
                "name": "MessageSid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the message"
              },
              {
                "name": "MediaSid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Twilio Delete a Media Resource"
        }
      ]
    }
  ],
  "bundled": true
}