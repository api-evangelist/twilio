{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Deactivations API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "Deactivations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FetchDeactivation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/Deactivations",
            "params": [
              {
                "name": "Date",
                "value": "",
                "type": "query",
                "description": "The request will return a list of all United States Phone Numbers that were deactivated on the day specified by this parameter. This date should be specified in YYYY-MM-DD format."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetch a list of all United States numbers that have been deactivated on a specific date."
        }
      ]
    }
  ],
  "bundled": true
}