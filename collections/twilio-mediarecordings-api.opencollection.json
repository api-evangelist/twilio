{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Media Recordings API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "MediaRecordings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FetchMediaRecording",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/MediaRecordings/:Sid",
            "params": [
              {
                "name": "Sid",
                "value": "",
                "type": "path",
                "description": "The SID of the MediaRecording resource to fetch."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns a single MediaRecording resource identified by a SID."
        },
        {
          "info": {
            "name": "DeleteMediaRecording",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.twilio.com/v1/MediaRecordings/:Sid",
            "params": [
              {
                "name": "Sid",
                "value": "",
                "type": "path",
                "description": "The SID of the MediaRecording resource to delete."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Deletes a MediaRecording resource identified by a SID."
        },
        {
          "info": {
            "name": "ListMediaRecording",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/MediaRecordings",
            "params": [
              {
                "name": "Order",
                "value": "",
                "type": "query",
                "description": "The sort order of the list by `date_created`. Can be: `asc` (ascending) or `desc` (descending) with `desc` as the default."
              },
              {
                "name": "Status",
                "value": "",
                "type": "query",
                "description": "Status to filter by, with possible values `processing`, `completed`, `deleted`, or `failed`."
              },
              {
                "name": "ProcessorSid",
                "value": "",
                "type": "query",
                "description": "SID of a MediaProcessor to filter by."
              },
              {
                "name": "SourceSid",
                "value": "",
                "type": "query",
                "description": "SID of a MediaRecording source to filter by."
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query",
                "description": "How many resources to return in each list page. The default is 50, and the maximum is 1000."
              },
              {
                "name": "Page",
                "value": "",
                "type": "query",
                "description": "The page index. This value is simply for client state."
              },
              {
                "name": "PageToken",
                "value": "",
                "type": "query",
                "description": "The page token. This is provided by the API."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns a list of MediaRecordings."
        }
      ]
    }
  ],
  "bundled": true
}