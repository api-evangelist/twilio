{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Configs API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "Configs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ListAccountConfig",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/Configs",
            "params": [
              {
                "name": "PageSize",
                "value": "",
                "type": "query",
                "description": "How many resources to return in each list page. The default is 50, and the maximum is 1000."
              },
              {
                "name": "Page",
                "value": "",
                "type": "query",
                "description": "The page index. This value is simply for client state."
              },
              {
                "name": "PageToken",
                "value": "",
                "type": "query",
                "description": "The page token. This is provided by the API."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a list of all Configs for an Account."
        },
        {
          "info": {
            "name": "CreateAccountConfig",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.twilio.com/v1/Configs",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a config for an Account."
        },
        {
          "info": {
            "name": "FetchAccountConfig",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/Configs/:Key",
            "params": [
              {
                "name": "Key",
                "value": "",
                "type": "path",
                "description": "The config key; up to 100 characters."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a Config for an Account."
        },
        {
          "info": {
            "name": "UpdateAccountConfig",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.twilio.com/v1/Configs/:Key",
            "params": [
              {
                "name": "Key",
                "value": "",
                "type": "path",
                "description": "The config key; up to 100 characters."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update a config for an Account."
        },
        {
          "info": {
            "name": "DeleteAccountConfig",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.twilio.com/v1/Configs/:Key",
            "params": [
              {
                "name": "Key",
                "value": "",
                "type": "path",
                "description": "The config key; up to 100 characters."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete a config for an Account."
