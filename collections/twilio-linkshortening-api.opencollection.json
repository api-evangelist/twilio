      "info": {
        "name": "LinkShortening",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FetchDomainCertV4",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/LinkShortening/Domains/:DomainSid/Certificate",
            "params": [
              {
                "name": "DomainSid",
                "value": "",
                "type": "path",
                "description": "Unique string used to identify the domain that this certificate should be associated with."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          }
        },
        {
          "info": {
            "name": "UpdateDomainCertV4",
            "type": "http"
          },
          "http": {
