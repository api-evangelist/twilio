{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twilio - Accounts A2p Recording Settings API",
    "version": "1.52.0"
  },
  "items": [
    {
      "info": {
        "name": "RecordingSettings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FetchRecordingSettings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.twilio.com/v1/RecordingSettings/Default",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          }
        },
        {
          "info": {
            "name": "CreateRecordingSettings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.twilio.com/v1/RecordingSettings/Default",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}